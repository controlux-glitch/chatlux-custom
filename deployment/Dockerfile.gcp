FROM chatwoot/chatwoot@sha256:b419dded7e9d2f54a24fd427b74ba7e6069d601b500618045c1eb6c01a1cc9a1 AS builder

WORKDIR /release
ARG NODE_OPTIONS=--max-old-space-size=4096
ENV EXECJS_RUNTIME=Node
ENV NODE_OPTIONS=${NODE_OPTIONS}

COPY Gemfile Gemfile.lock package.json pnpm-lock.yaml /release/

# Reuse the official gems only while the dependency lock matches exactly.
RUN cmp Gemfile.lock /app/Gemfile.lock && bundle check
RUN node /usr/local/lib/node_modules/npm/bin/npm-cli.js install -g pnpm@10.2.0 \
  && pnpm install --frozen-lockfile --prod=false
COPY . /release
RUN SECRET_KEY_BASE=precompile_placeholder RAILS_LOG_TO_STDOUT=true bundle exec rake assets:precompile \
  && git rev-parse HEAD > .git_sha \
  && rm -rf node_modules .git tmp/cache

FROM chatwoot/chatwoot@sha256:b419dded7e9d2f54a24fd427b74ba7e6069d601b500618045c1eb6c01a1cc9a1

RUN rm -rf /app
COPY --from=builder /release /app
WORKDIR /app
EXPOSE 3000
